# Dependencies installed with npm i
node_modules/

# Generated builds and caches
dist/
dist-ssr/
.vite/
coverage/
*.tsbuildinfo

# Local environment configuration
.env
.env.*
!.env.example
!.env.sample

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Markdown notes and answer guides
*.md
!errores.md
!README.md
!AGENTS.md

# Project skills and generated context ARE documentation, so they are tracked
!/.agents/
!/.agents/**/*.md
!/.contexto/
!/.contexto/**/*.md
# Test fixtures ship a nested .git; without this they land as gitlinks (submodules)
.agents/skills/*/evals/fixtures/
# Junctions to .agents/skills so opencode discovers them; git must not see the
# skills a second time through this path, nor the fixtures nested behind it
.opencode/skills/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
