# Dependencies installed with npm i
node_modules/

# Generated builds and caches
dist/
dist-ssr/
.vite/
coverage/
*.tsbuildinfo

# Local environment configuration
.env
.env.*
!.env.example
!.env.sample

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Markdown notes and answer guides
*.md
!errores.md
!README.md
!AGENTS.md

# Project skills and generated context ARE documentation, so they are tracked
!/.agents/
!/.agents/**/*.md
!/.contexto/
!/.contexto/**/*.md
# .opencode/skills/ holds junctions to .agents/skills so the agent discovers them once.
# git must not see the same file a second time through that path
.opencode/skills/
# Sandbox de evaluaciones: corrida previa y sus gradings. Se regenera en cada benchmark
evals-workspace/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
